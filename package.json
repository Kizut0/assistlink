{
  "name": "assistlink",
  "version": "1.0.0",
  "description": "A platform connecting students with research and teaching opportunities.",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:test-users": "tsx prisma/seed-test-users.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:production": "tsx src/scripts/migrate-production.ts",
    "migrate:reset": "prisma migrate reset",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "test:web": "node --import tsx --test tests/web.test.ts tests/users.test.ts tests/frontend.test.cjs tests/ranking.test.ts tests/profiles.test.ts tests/key-vault.test.ts",
    "test:users:db": "RUN_DATABASE_TESTS=1 node --import tsx --test tests/users.db.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kizut0/assistlink.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Kizut0/assistlink/issues"
  },
  "homepage": "https://github.com/Kizut0/assistlink#readme",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/msal-node": "^5.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
