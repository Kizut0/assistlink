# ---------- REQUIRED SECRETS (Key Vault entry name in brackets) ----------
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/assistlink   # [DATABASE-URL]
JWT_SECRET=dev-only-change-me                                          # [JWT-SECRET]
AD_CLIENT_SECRET=placeholder-ad-client-secret                          # [AD-CLIENT-SECRET]

# ---------- PUBLIC AD IDENTIFIERS (not secrets, not Key Vault) ----------
AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AD_REDIRECT_URI=http://localhost:8081/assistlink/api/auth/callback

# ---------- ORDINARY CONFIG ----------
PORT=8081
NODE_ENV=development
JWT_EXPIRES_IN=30m
# Ranking provider. Production uses OpenRouter; the free endpoint is suitable
# for a low-volume demonstration and may be rate-limited.
RANKING_PROVIDER=openrouter
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Optional until you use ranking. In production this is loaded from Key Vault
# secret OPENROUTER-API-KEY.
# OPENROUTER_API_KEY=your-openrouter-key

# Gemini remains available as a local/backward-compatible provider.
GEMINI_MODEL=gemini-3.6-flash
# Optional until you use ranking. Create one in Google AI Studio.
# GEMINI_API_KEY=your-google-ai-studio-key

# ---------- OPTIONAL DEMO LOGIN ----------
# Enables the blank email/passcode form. Use only for a controlled demo.
DEMO_AUTH_ENABLED=false
# In production this is loaded from Key Vault secret DEMO-AUTH-PASSCODE.
# DEMO_AUTH_PASSCODE=choose-a-strong-temporary-passcode

# ---------- PRODUCTION KEY VAULT ----------
# Required when NODE_ENV=production. DefaultAzureCredential supports managed
# identity, Azure CLI locally, or AZURE_CLIENT_ID/AZURE_TENANT_ID/AZURE_CLIENT_SECRET.
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net

# ---------- DEV ONLY (non-production impersonation; never on a server) ----------
# Send header:  x-dev-user: {"userId":1,"role":"PROFESSOR","email":"prof@au.edu"}
