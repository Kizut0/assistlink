# Non-secret production configuration only. Copy to .env.production on the VM.
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
POSTGRES_PASSWORD_FILE=/etc/assistlink/postgres-password
AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AD_REDIRECT_URI=https://your-domain.example/assistlink/api/auth/callback
RANKING_PROVIDER=openrouter
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_API_KEY is loaded from Key Vault secret OPENROUTER-API-KEY.
GEMINI_MODEL=gemini-3.6-flash
DEMO_AUTH_ENABLED=false
